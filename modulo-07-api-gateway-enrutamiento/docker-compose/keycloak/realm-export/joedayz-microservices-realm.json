{
  "realm": "joedayz-microservices",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "roles": {
    "realm": [
      { "name": "orders_reader" },
      { "name": "orders_writer" },
      { "name": "orders_admin" },
      { "name": "inventory_viewer" },
      { "name": "inventory_manager" },
      { "name": "inventory_admin" }
    ]
  },
  "clients": [
    {
      "clientId": "student-portal",
      "name": "Student Portal",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect",
      "defaultClientScopes": ["profile", "email", "roles"],
      "protocolMappers": [
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "region",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "region",
            "claim.name": "region",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "order-service",
      "name": "Order Service",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "inventory-service",
      "name": "Inventory Service",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "ana-reader",
      "enabled": true,
      "email": "ana-reader@joedayz.pe",
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Reader",
      "attributes": {
        "tenant_id": ["tienda-deportes"],
        "region": ["PE"]
      },
      "credentials": [
        { "type": "password", "value": "secret123", "temporary": false }
      ],
      "realmRoles": ["orders_reader", "inventory_viewer"]
    },
    {
      "username": "bruno-manager",
      "enabled": true,
      "email": "bruno-manager@joedayz.pe",
      "emailVerified": true,
      "firstName": "Bruno",
      "lastName": "Manager",
      "attributes": {
        "tenant_id": ["tienda-deportes"],
        "region": ["PE"]
      },
      "credentials": [
        { "type": "password", "value": "secret123", "temporary": false }
      ],
      "realmRoles": ["orders_writer", "inventory_manager"]
    },
    {
      "username": "carla-admin",
      "enabled": true,
      "email": "carla-admin@joedayz.pe",
      "emailVerified": true,
      "firstName": "Carla",
      "lastName": "Admin",
      "attributes": {
        "tenant_id": ["plataforma"],
        "region": ["LATAM"]
      },
      "credentials": [
        { "type": "password", "value": "secret123", "temporary": false }
      ],
      "realmRoles": ["orders_admin", "inventory_admin"]
    }
  ]
}
