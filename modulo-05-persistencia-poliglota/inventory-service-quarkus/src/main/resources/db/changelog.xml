<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1-create-inventory-items" author="copilot">
        <createTable tableName="inventory_items">
            <column name="sku" type="varchar(60)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(120)">
                <constraints nullable="false"/>
            </column>
            <column name="warehouse_code" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="available_quantity" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="reserved_quantity" type="integer">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
