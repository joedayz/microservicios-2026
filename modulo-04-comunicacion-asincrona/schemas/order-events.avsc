[
  {
    "type": "record",
    "name": "OrderCreatedEvent",
    "namespace": "pe.joedayz.microservicios.order.events",
    "doc": "Publicado por Order Service al iniciar la saga de checkout (v1).",
    "fields": [
      {"name": "orderId", "type": "string"},
      {"name": "tenantId", "type": "string"},
      {"name": "customerId", "type": "string"},
      {"name": "sku", "type": "string"},
      {"name": "quantity", "type": "int"},
      {"name": "createdAt", "type": {"type": "long", "logicalType": "timestamp-millis"}}
    ]
  },
  {
    "type": "record",
    "name": "ReserveStockCommand",
    "namespace": "pe.joedayz.microservicios.order.events",
    "doc": "Comando enviado por el orquestador (Order Service) a Catalog Service.",
    "fields": [
      {"name": "orderId", "type": "string"},
      {"name": "tenantId", "type": "string"},
      {"name": "sku", "type": "string"},
      {"name": "quantity", "type": "int"}
    ]
  },
  {
    "type": "record",
    "name": "OrderConfirmedEvent",
    "namespace": "pe.joedayz.microservicios.order.events",
    "doc": "Estado final exitoso de la saga.",
    "fields": [
      {"name": "orderId", "type": "string"},
      {"name": "tenantId", "type": "string"},
      {"name": "confirmedAt", "type": {"type": "long", "logicalType": "timestamp-millis"}}
    ]
  },
  {
    "type": "record",
    "name": "OrderFailedEvent",
    "namespace": "pe.joedayz.microservicios.order.events",
    "doc": "Estado final fallido de la saga (compensación aplicada).",
    "fields": [
      {"name": "orderId", "type": "string"},
      {"name": "tenantId", "type": "string"},
      {"name": "reason", "type": "string"},
      {"name": "failedAt", "type": {"type": "long", "logicalType": "timestamp-millis"}}
    ]
  }
]
